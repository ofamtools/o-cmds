{
  "name": "run history UI can be disabled without changing script view",
  "commands": [{"name": "quiet-command", "script": "printf quiet\n"}],
  "runs": [{"command": "quiet-command", "stdout": "recorded", "exitCode": 0}],
  "settings": {"view.runs": false},
  "script": ["H", "v", "esc"],
  "expect": [
    {"after": 0, "lacks": ["Last run:"]},
    {"after": 1, "modal": false, "lacks": ["Runs: quiet-command"]},
    {"after": 2, "modal": true, "contains": ["printf quiet"]},
    {"after": 3, "modal": false, "selected": "quiet-command"}
  ]
}
